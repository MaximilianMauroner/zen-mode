{
  "expo": {
    "name": "Zen Mode",
    "slug": "zen-mode",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/refuge/icon.png",
    "scheme": "zenmode",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1210",
    "ios": {
      "icon": "./assets/images/refuge/icon.png"
    },
    "android": {
      "package": "com.lab4code.zenmode",
      "versionCode": 7,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D1210",
        "foregroundImage": "./assets/images/refuge/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/refuge/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1210",
          "image": "./assets/images/refuge/mark.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "./plugins/with-android-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ffa0a46-ef47-46e6-9765-697c9da8ba63"
      }
    },
    "owner": "thearizztokrat"
  }
}
