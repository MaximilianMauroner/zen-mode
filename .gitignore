# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local environment files
.env
.env.*
!.env.example

# Never commit a Google Play API service-account key
google-service-account.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
/modules/*/android/build/

# Local agent research and planning artifacts
/.agents/artifacts/

# Image generation drafts and source exports
/output/imagegen/

# Reviewer recordings are external release artifacts, not source assets
/docs/store-assets/**/*.mp4
